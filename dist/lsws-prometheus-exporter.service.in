[Unit]
Description=LiteSpeed Web Server Prometheus Exporter
After=network-online.target remote-fs.target nss-lookup.target
Wants=network-online.target

[Service]
PIDFile=/run/lsws-prometheus-exporter/lsws-prometheus-exporter.pid
RuntimeDirectory=lsws-prometheus-exporter
ExecStart=/usr/local/lsws-prometheus-exporter/lsws-prometheus-exporter %CERT_FILE% %KEY_FILE% %USER_NAME% %PASSWORD_FILE%
Restart=always

# Layered hardening — see README "Security considerations".
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
# PrivateTmp=true gives the unit its own /tmp namespace, so without this
# bind the exporter cannot see LSWS's /tmp/lshttpd/.rtreport file and
# /metrics is empty. Bind it read-only so we get the hardening AND the
# data. If --rtreport is moved out of /tmp this line can go away.
BindReadOnlyPaths=/tmp/lshttpd
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictNamespaces=true
LockPersonality=true
MemoryDenyWriteExecute=true
SystemCallArchitectures=native
ReadWritePaths=/run/lsws-prometheus-exporter

[Install]
WantedBy=multi-user.target
